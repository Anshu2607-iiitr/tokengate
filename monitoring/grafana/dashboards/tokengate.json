{
  "uid": "tokengate",
  "title": "TokenGate",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "type": "stat", "title": "Requests (last 15m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(tokengate_gateway_requests_total[15m]))" } ]
    },
    {
      "type": "stat", "title": "Cache hit rate (5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(tokengate_gateway_requests_total{cache=\"hit\"}[5m])) / sum(rate(tokengate_gateway_requests_total[5m]))" } ]
    },
    {
      "type": "stat", "title": "Cost (last 24h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(tokengate_cost_usd_total[24h]))" } ]
    },
    {
      "type": "stat", "title": "Dead letters",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "max(tokengate_kafka_dead_letters)" } ]
    },
    {
      "type": "timeseries", "title": "Rate: requests/sec by provider",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (provider) (rate(tokengate_gateway_requests_total[1m]))", "legendFormat": "{{provider}}" } ]
    },
    {
      "type": "timeseries", "title": "Errors: rejections/sec by reason",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (reason) (rate(tokengate_gateway_rejections_total[1m]))", "legendFormat": "{{reason}}" } ]
    },
    {
      "type": "timeseries", "title": "Duration: provider latency p50 / p95",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(tokengate_gateway_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tokengate_gateway_latency_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "title": "Streaming: time to first token p95",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(tokengate_gateway_first_token_seconds_bucket[5m])))", "legendFormat": "{{provider}}" } ]
    },
    {
      "type": "timeseries", "title": "Cost by team (per hour)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (team) (increase(tokengate_cost_usd_total[1h]))", "legendFormat": "{{team}}" } ]
    },
    {
      "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" } ]
    }
  ]
}